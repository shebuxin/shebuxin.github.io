ANALYTICS_ADMIN_TOKEN=replace-with-a-random-token-at-least-32-characters
ANALYTICS_ID_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ANALYTICS_ORIGINS=https://shebuxin.github.io
# Optional local GeoIP2/GeoLite2 City database; mount it read-only when using Docker.
# ANALYTICS_GEOIP_DATABASE=/geoip/GeoLite2-City.mmdb
# Exact proxy IP/CIDR allowed to set X-Real-IP. Leave empty without a proxy.
# ANALYTICS_TRUSTED_PROXIES=127.0.0.1/32
